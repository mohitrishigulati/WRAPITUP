# PostgreSQL (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js / NextAuth (server-only)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-secret"
# Public site URL (no trailing slash) — required on Vercel for OAuth
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# On Vercel production use: https://wrapitup-two.vercel.app (or your custom domain)

# Google OAuth (server-only; redirect URI: {AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (secret key + webhook secret: server-only; publishable key: client-safe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Shipping (USD): flat rate, free when subtotal after discount >= threshold
SHIPPING_FLAT_RATE="5.99"
SHIPPING_FREE_THRESHOLD="75"

# Resend order emails (server-only). Password reset may still use SMTP below.
RESEND_API_KEY=""
EMAIL_FROM="WrapItUp <no-reply@yourdomain.com>"

# Optional SMTP for password reset (server-only)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Object storage (S3-compatible: AWS S3, Cloudflare R2, etc.)
# When all required vars are set, uploads go to the bucket instead of public/uploads/.
# Omit for local dev (filesystem under public/uploads/).
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2 example: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# Public URL prefix for browser/CDN reads (no trailing slash), e.g. https://cdn.example.com or R2 public bucket URL
S3_PUBLIC_URL=""

NODE_ENV="development"
